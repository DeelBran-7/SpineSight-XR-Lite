# Copy to .env at the project root or to backend/.env. Keep credentials private.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30

# Multiple explicit origins can be separated by commas. Vite uses a same-origin proxy.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Relative to the backend directory. Use the official Pose Landmarker Lite asset.
POSE_MODEL_PATH=models/pose_landmarker_lite.task
LANDMARK_VISIBILITY_THRESHOLD=0.60
